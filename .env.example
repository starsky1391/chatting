# ============================================
# Chat Application Environment Configuration
# ============================================
# Copy this file to .env and update the values
# Generate secrets: openssl rand -base64 48

# ============ Database Configuration ============
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=chat_app
DB_PORT=5432

# ============ Redis Configuration ============
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# ============ Kafka Configuration ============
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_EVENTS=chat.events
KAFKA_TOPIC_EMAILS=chat.email.jobs
# Leave empty to auto-generate a unique consumer group per backend instance
KAFKA_CONSUMER_GROUP=

# ============ JWT Configuration ============
# Generate: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============ CORS Configuration ============
# For production: https://yourdomain.com
CORS_ORIGIN=*

# ============ Backend Configuration ============
BACKEND_PORT=3001
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# ============ Frontend Configuration ============
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
# Internal URL used by the Next.js image optimizer to fetch uploaded images.
# Docker Compose defaults this to http://backend:3001.
NEXT_PUBLIC_IMAGE_URL=

# ============ AI Bot Configuration ============
# POST endpoint used by the group AI bot. It should accept JSON with prompt/message.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Optional project-level NewsNow compatible API. Group owners do not need to configure this.
NEWSNOW_API_URL=https://newsnow.busiyi.world

# ============ Email Verification Configuration ============
# Without SMTP_HOST, registration codes are logged by the backend for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Chatting
# true for implicit TLS ports like 465. Leave false for STARTTLS/587.
SMTP_USE_TLS=false
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_QUEUE_SIZE=100

# ============ Nginx Configuration ============
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# ============ Build Configuration ============
# NPM registry for Docker build (use official if mirror fails)
# China mirror: https://registry.npmmirror.com
# Official: https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com

# ============ Production Notes ============
# 1. Use strong passwords (16+ chars, mixed case, numbers, symbols)
# 2. Generate JWT_SECRET: openssl rand -base64 48
# 3. Set CORS_ORIGIN to your actual domain
# 4. Use Docker secrets or external secrets manager
# 5. Enable HTTPS with proper SSL certificates
