# ============================================
# Docker Compose 环境变量配置模板
# 请复制此文件为 .env 并修改为实际值
# ============================================

# ============ 数据库配置 ============
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=chat_app
DB_PORT=5432

# ============ Redis 配置 ============
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# ============ RabbitMQ 配置 ============
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ============ 后端服务配置 ============
BACKEND_PORT=3001
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*

# ============ 前端配置 ============
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=

# ============ Nginx 配置 ============
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============ 生产环境注意事项 ============
# 1. 所有密码必须使用强密码（至少16位，包含大小写字母、数字、特殊字符）
# 2. JWT_SECRET 必须是随机生成的长字符串
# 3. 生产环境请关闭不必要的端口映射
# 4. 建议使用 Docker secrets 或外部密钥管理系统
