# Server
PORT=3001
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatapp
# Or use individual fields:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=chatapp

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=86400

# Bootstrap admin account
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka (optional, used for realtime event fanout)
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC_EVENTS=chat.events
# Leave empty to auto-generate a unique consumer group per backend instance
KAFKA_CONSUMER_GROUP=

# Wechat Mini Program Config
WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_appsecret
