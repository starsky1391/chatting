{
  "rabbit_version": "3.13",
  "users": [
    {
      "name": "admin",
      "password": "rabbitmq123",
      "tags": "administrator"
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "admin",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "chat.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "chat.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "chat.messages",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "chat.dlx",
        "x-dead-letter-routing-key": "dead"
      }
    },
    {
      "name": "chat.notifications",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "chat.dlx",
        "x-dead-letter-routing-key": "dead"
      }
    },
    {
      "name": "chat.dead_letters",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "chat.events",
      "vhost": "/",
      "destination": "chat.messages",
      "destination_type": "queue",
      "routing_key": "message.*",
      "arguments": {}
    },
    {
      "source": "chat.events",
      "vhost": "/",
      "destination": "chat.notifications",
      "destination_type": "queue",
      "routing_key": "notification.*",
      "arguments": {}
    },
    {
      "source": "chat.dlx",
      "vhost": "/",
      "destination": "chat.dead_letters",
      "destination_type": "queue",
      "routing_key": "dead",
      "arguments": {}
    }
  ]
}
